<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cargando Azeroth...</title>
  <style>
    /* ===== Variables de WoW ===== */
    :root {
      --fondo-wow: #050a12; /* Fondo oscuro azulado */
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: system-ui, sans-serif;
      background-color: var(--fondo-wow);
      color: #fff;
    }

    /* ===== Pantalla de carga ===== */
    #loading-screen {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 30px;
      background: radial-gradient(circle at center, #0f172a 0%, var(--fondo-wow) 80%);
      transition: opacity 0.8s ease, visibility 0.8s ease;
    }

    #loading-screen.hide {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* ===== Contenedor de la W ===== */
    .wow-loader {
      position: relative;
      width: 160px;
      height: 160px;
      display: flex;
      justify-content: center;
      align-items: center;
      /* Respiración sutil de la W */
      animation: latido-wow 4s ease-in-out infinite alternate;
      /* Resplandor amarillo general */
      filter: drop-shadow(0 0 15px rgba(251, 191, 36, 0.3));
    }

    .w-icon {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    /* El borde base amarillo */
    .w-border-base {
      filter: drop-shadow(0 0 4px #fbbf24);
    }

    /* La luz que viaja infinitamente */
    .w-glow-border {
      /* Un trozo de luz y un hueco gigante */
      stroke-dasharray: 200 800; 
      stroke-dashoffset: 0;
      /* Animación lineal para bucle perfecto */
      animation: viaje-luz 2.5s linear infinite;
      filter: drop-shadow(0 0 8px #fef08a) drop-shadow(0 0 15px #fbbf24);
    }

    /* ===== Texto estilo fantasía ===== */
    .loading-text {
      font-family: 'Cinzel', 'Times New Roman', serif;
      font-size: 16px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      font-weight: 700;
      color: transparent;
      
      /* Degradado de luz dorada */
      background: radial-gradient(circle, #ffffff 0%, #fbbf24 40%, #78350f 100%);
      background-size: 200% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      
      animation: luz-texto-wow 2.5s linear infinite;
    }

    /* ===== Animaciones ===== */
    @keyframes latido-wow {
      0% { transform: scale(0.98); }
      100% { transform: scale(1.02); }
    }

    /* El viaje infinito de la luz por el borde */
    @keyframes viaje-luz {
      0% { stroke-dashoffset: 0; }
      100% { stroke-dashoffset: -1000; } /* -1000 coincide con pathLength="1000" */
    }

    /* El texto brilla al mismo ritmo */
    @keyframes luz-texto-wow {
      0% { background-position: 150% center; filter: drop-shadow(0 0 2px transparent); }
      50% { background-position: 50% center; filter: drop-shadow(0 0 8px #fbbf24); }
      100% { background-position: -50% center; filter: drop-shadow(0 0 2px transparent); }
    }

    /* ===== Contenido de ejemplo de tu página ===== */
    .main-content {
      min-height: 100vh;
      display: grid;
      place-content: center;
      text-align: center;
      padding: 24px;
    }
  </style>
</head>
<body>

  <!-- 1. Pantalla de carga -->
  <div id="loading-screen" role="status" aria-label="Cargando">
    <div class="wow-loader">
      <svg viewBox="0 0 200 200" class="w-icon">
        <defs>
          <!-- Degradado del relleno -->
          <linearGradient id="wowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e3a8a" />
            <stop offset="50%" stop-color="#0f172a" />
            <stop offset="100%" stop-color="#1e3a8a" />
          </linearGradient>
        </defs>

        <!-- Relleno sólido de la W -->
        <path class="w-fill" 
              d="M 15 20 L 55 180 L 85 100 L 100 150 L 115 100 L 145 180 L 185 20 L 155 20 L 135 130 L 110 60 L 90 60 L 65 130 L 45 20 Z" 
              fill="url(#wowGrad)" />

        <!-- Borde amarillo base (siempre visible) -->
        <path class="w-border-base" 
              d="M 15 20 L 55 180 L 85 100 L 100 150 L 115 100 L 145 180 L 185 20 L 155 20 L 135 130 L 110 60 L 90 60 L 65 130 L 45 20 Z" 
              fill="none" 
              stroke="#fbbf24" 
              stroke-width="6" 
              stroke-linejoin="miter" />

        <!-- Luz que viaja infinitamente -->
        <path class="w-glow-border" 
              pathLength="1000"
              d="M 15 20 L 55 180 L 85 100 L 100 150 L 115 100 L 145 180 L 185 20 L 155 20 L 135 130 L 110 60 L 90 60 L 65 130 L 45 20 Z" 
              fill="none" 
              stroke="#fef08a" 
              stroke-width="6" 
              stroke-linejoin="miter" />
      </svg>
    </div>
    <div class="loading-text">Conectando a Azeroth...</div>
  </div>

  <!-- 2. Tu página web real (contenido de ejemplo) -->
  <main class="main-content">
    <h1>¡Bienvenido a mi página de WoW!</h1>
    <p>La pantalla de carga ha desaparecido suavemente.</p>
  </main>

  <!-- 3. El JavaScript -->
  <script>
    window.addEventListener("load", () => {
      setTimeout(() => {
        const loader = document.getElementById("loading-screen");
        if (loader) {
          loader.classList.add("hide");
        }
      }, 3500); // 3.5 segundos de carga
    });
  </script>

</body>
</html>
